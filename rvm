#!/usr/bin/env bash
# RVM (Ratana Vim) — Powered by Neovim Core Engine (github.com/neovim/neovim)
# Combines Neovim runtime, LazyVim architecture, Tree-sitter, LSP, and Khmer UI.
RVM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Check if user explicitly requested Rust native TUI fallback
if [ "$1" = "--native" ]; then
    shift
    if [ -x "$HOME/.local/bin/rvm-native" ]; then
        exec "$HOME/.local/bin/rvm-native" "$@"
    else
        echo "Error: rvm-native binary not found."
        exit 1
    fi
fi

# Primary engine: Source-built rvm-engine or System Neovim (github.com/neovim/neovim)
if [ -x "$HOME/.local/bin/rvm-engine" ]; then
    exec "$HOME/.local/bin/rvm-engine" -u "$RVM_ROOT/init.lua" "$@"
elif command -v nvim >/dev/null 2>&1; then
    exec nvim -u "$RVM_ROOT/init.lua" "$@"
elif [ -x "$HOME/.local/bin/rvm-native" ]; then
    exec "$HOME/.local/bin/rvm-native" "$@"
else
    echo "Error: Neovim (nvim) is not installed on this system."
    exit 1
fi
